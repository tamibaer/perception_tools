# Flaches Rechteck (0.19m x 0.29m) mit dem ArUco-GridBoard als Textur,
# zentriert im Ursprung, Normale zeigt +Z (liegt flach auf dem Tisch).
mtllib aruco_board.mtl

v -0.095 -0.145 0.0
v  0.095 -0.145 0.0
v  0.095  0.145 0.0
v -0.095  0.145 0.0

vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

vn 0.0 0.0 1.0

usemtl aruco_material
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1
